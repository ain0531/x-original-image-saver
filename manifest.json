{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "X 原寸画像保存",
  "version": "0.1.0",
  "description": "Xの投稿画像を原寸で保存します。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "X 原寸画像保存を開く"
  },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["dist/bookmark-reader.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
